# =============================================================
# BACKEND — Cloudflare Worker Secrets & Vars
# =============================================================
# HOW TO USE:
#   Non-secret vars  → put in wrangler.jsonc under "vars"
#   Secret vars      → set with:  npx wrangler secret put VAR_NAME
#   Never commit real values to git.
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ── Telegram Stars Bot (existing — DreamHome website flow) ────
# Get token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your own Telegram chat ID (for admin notifications)
# Get it from @userinfobot
TELEGRAM_CHAT_ID=1234567890
# ── Telegram Cashfree Ticket Bot ──────────────────────────────
# Create a NEW separate bot via @BotFather for ticket sales
CF_BOT_TOKEN=9876543210:BBxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bot username without @ (set in wrangler.jsonc vars)
CF_BOT_USERNAME=supremv_bot

# ── Cashfree ──────────────────────────────────────────────────
# Encryption root for admin-managed integration secrets.
CONFIG_ENCRYPTION_KEY=your-long-random-encryption-key
# Get from: Cashfree Dashboard → Developers → API Keys
# Sandbox:    https://merchant.cashfree.com/merchants/login
# Production: https://merchant.cashfree.com/merchants/login
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
# "sandbox" for testing, "production" for live payments
# (set in wrangler.jsonc vars — not a secret)
CASHFREE_ENVIRONMENT=sandbox
# Get from: Cashfree Dashboard → Developers → Webhooks → Secret Key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret

# ── Worker public URL ─────────────────────────────────────────
# Your deployed Cloudflare Worker URL
# (set in wrangler.jsonc vars — not a secret)
API_BASE_URL=https://apis-realestate.workers.dev

# =============================================================
# COMMANDS TO SET SECRETS IN CLOUDFLARE (run one by one):
# =============================================================
# npx wrangler secret put SUPABASE_KEY
# npx wrangler secret put JWT_SECRET
# npx wrangler secret put TELEGRAM_BOT_TOKEN 8965220352:AAGSXGXErG5RsjiP-o1VViTksOsLc9thBd0
# npx wrangler secret put CF_BOT_TOKEN
# npx wrangler secret put CASHFREE_CLIENT_ID
# npx wrangler secret put CASHFREE_CLIENT_SECRET
# npx wrangler secret put CASHFREE_WEBHOOK_SECRET
# =============================================================
